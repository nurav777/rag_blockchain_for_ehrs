# ============================================================
# APPLICATION
# ============================================================
APP_NAME=Medical Records API
APP_VERSION=0.2.0
DEBUG=true

# ============================================================
# WALLET AUTHENTICATION
# ============================================================
# Wallet signatures establish clinician identity. These settings only sign
# short-lived challenge/access tokens; there are no email/password accounts.
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
WALLET_CHALLENGE_EXPIRE_SECONDS=300

# ============================================================
# BLOCKCHAIN / HYPERLEDGER BESU
# ============================================================
BESU_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
CONTRACT_ABI_PATH=./blockchain/abi/MedicalRecordRegistry.json

# Local development deployer/contract-owner relayer. Clinician identity
# never comes from this infrastructure key.
DEPLOYER_PRIVATE_KEY=

# Optional separate wallet used by demo scripts. Authorize it first with
# scripts/authorize_wallet.py. If empty, seed_demo_records.py falls back to
# DEPLOYER_PRIVATE_KEY for local demo use.
DEMO_WALLET_PRIVATE_KEY=

# ============================================================
# RAG / EMBEDDINGS
# ============================================================
CHROMA_PERSIST_DIR=./data/chromadb
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
OLLAMA_TIMEOUT=120

# ============================================================
# FILE VALIDATION
# ============================================================
MAX_UPLOAD_SIZE_MB=10

# ============================================================
# PINATA / IPFS
# ============================================================
# Prototype/demo pinning provider only. The intended architecture is
# provider-independent and can use user/consortium-operated IPFS nodes.
PINATA_JWT=
PINATA_UPLOAD_TIMEOUT=60
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
