# ============================================================
# APPLICATION
# ============================================================

APP_NAME=Medical Records API
APP_VERSION=0.1.0
DEBUG=true


# ============================================================
# DATABASE
# ============================================================

# Application identity data only.
# Medical records themselves are NOT stored in SQLite.

DATABASE_URL=sqlite:///./data/medical_records.db


# ============================================================
# AUTHENTICATION
# ============================================================

SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ============================================================
# BLOCKCHAIN / HYPERLEDGER BESU
# ============================================================

BESU_RPC_URL=http://127.0.0.1:8545

# Automatically written by:
#
# python blockchain/scripts/deploy.py

CONTRACT_ADDRESS=

CONTRACT_ABI_PATH=./blockchain/abi/MedicalRecordRegistry.json

# Automatically generated by deploy.py for local development
# if left empty.
#
# Do not commit your real .env file.

DEPLOYER_PRIVATE_KEY=


# ============================================================
# RAG / EMBEDDINGS
# ============================================================

CHROMA_PERSIST_DIR=./data/chromadb

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

EMBEDDING_MODEL=all-MiniLM-L6-v2

RAG_TOP_K=5
OLLAMA_TIMEOUT=120


# ============================================================
# FILE VALIDATION
# ============================================================

MAX_UPLOAD_SIZE_MB=10


# ============================================================
# PINATA / IPFS
# ============================================================

# Create a Pinata API token/JWT and place it here.

PINATA_JWT=

PINATA_UPLOAD_TIMEOUT=60

PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]