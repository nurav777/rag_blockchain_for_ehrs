# Leave API base empty when using the Vite proxy in development.
VITE_API_BASE_URL=

# Besu JSON-RPC endpoint used by the Blockchain page.
# If browser CORS blocks it, expose the same RPC through a backend proxy later.
VITE_BESU_RPC_URL=/besu-rpc

# Your local consortium chain id.
VITE_CHAIN_ID=1337
